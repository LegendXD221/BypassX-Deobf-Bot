# ---- required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Application ID (same page → General Information). Needed for slash commands + invite.
CLIENT_ID=

# ---- optional ---------------------------------------------------------------
# Restrict slash-command registration to one guild for instant updates (dev).
GUILD_ID=

# Command prefix for message commands (default: .)
PREFIX=.

# Pastefy API token (free at https://pastefy.app/apikeys). Anonymous pastes work without it.
PASTEFY_TOKEN=

# Pastefy paste expiry in days (0 = never; default 30)
PASTEFY_EXPIRE_DAYS=30

# Deobf engine download URL (default: this repo's GitHub Release asset).
# ENGINE_URL=https://github.com/LegendXD221/BypassX-Deobf-Bot/releases/latest/download/bypassx-deobf.gz
# Optional: path to an already-unpacked engine binary (skips download).
# ENGINE_PATH=/path/to/bypassx-deobf

# Optional GitHub token used only as a fallback engine download auth (never sent anywhere else).
GITHUB_TOKEN=

# Max upload size accepted from Discord users, in MB (default 10)
MAX_UPLOAD_MB=10
# Per-engine-run wall clock cap in seconds (default 180)
ENGINE_TIMEOUT_S=180
