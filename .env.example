# BypassX Deobf Bot — environment template (copy to .env or set in the Render dashboard)

# --- required ---
DISCORD_TOKEN=            # bot token (Discord dev portal → Bot)
CLIENT_ID=                # application id (slash registration)
# GUILD_ID=               # optional: instant per-guild slash commands while testing
PREFIX=.

# --- owner + 5-layer protection (dangerous commands) ---
OWNER_ID=1134757298733064203
# OWNER_PIN=              # optional layer 2: dangerous commands then need the PIN
                          # (prefix: first argument; slash: the `pin` option).
                          # 3 wrong attempts = 15-minute lockout.

# --- Neon Postgres (free tier) — leave unset to run without a database ---
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
                          # enables: job history (.history), all-time stats,
                          # owner audit trail, global blacklist.

# --- delivery + links ---
# PASTEFY_TOKEN=          # optional: authenticated Pastefy pastes
# GITHUB_TOKEN=           # optional: private-repo fetches for GitHub links

# --- keep-alive (Render free tier) ---
# PUBLIC_URL=https://bypassx-deobf-bot.onrender.com

# --- engine / limits (defaults are fine) ---
ENGINE_URL=https://github.com/LegendXD221/BypassX-Deobf-Bot/releases/latest/download/bypassx-deobf.gz
ENGINE_TIMEOUT_S=240
MAX_UPLOAD_MB=10
PASTEFY_EXPIRE_DAYS=30
DANGER_COOLDOWN_S=10
DANGER_MAX_PER_HOUR=12
CONFIRM_TIMEOUT_S=30
